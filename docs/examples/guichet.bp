blueprint blueprint:example/guichet {
  meta {
    author "Blueprint"
    description "Un guichet : un écran, un compteur, deux boutons"
    version "1.0.0"
    permission GAMEPLAY
  }
  var int jetons = 0 @player
  screen "guichet" {
    styles {
      "bouton" = "#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center
    }
    panel "cadre" @at(center, 0, 0) @size(160, 90) @layout(column, gap: 4, cross: stretch) @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "titre" @in("cadre") @at(top_left, 0, 0) @size(fill, 12) @text("Guichet") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "solde" @in("cadre") @at(top_left, 0, 0) @size(fill, 12) @bind("jetons", text, format: "Jetons : %s") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    button "prendre" @in("cadre") @at(top_left, 0, 0) @size(fill, 20) @text("Prendre un jeton") @uses("bouton") @style("#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center)
    button "fermer" @in("cadre") @at(top_left, 0, 0) @size(fill, 20) @text("Fermer") @uses("bouton") @style("#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("8478e98e-e6fa-34bf-98d2-c9eee6389f5f") @pos(-640, 260) @with(element: "prendre") {
    blueprint:var/set(var: "jetons", value: blueprint:math/add(a: blueprint:var/get(var: "jetons") @id("e4239468-13bf-37be-9a3f-ff7f506de895") @pos(-400, 460), b: 1.0) @id("9d017272-8903-324c-b991-6329e85b17bb") @pos(-160, 460)) @id("cd566462-49be-3c42-8e32-d3d5a6383f5e") @pos(-400, 260)
    blueprint:gui/refresh(player: $player, screen: "guichet") @id("12a3a030-d345-3a46-af1f-662bd808185e") @pos(-160, 260)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("a9a9258e-03d9-3d71-9f11-6358e17d01da") @pos(-640, 560) @with(element: "fermer") {
    blueprint:gui/close(player: $player) @id("da868519-a4f9-3f79-b5e9-992b4b70163f") @pos(-400, 560)
  }
  on blueprint:event/command(player, name, arg) @id("2dd4d57f-e57c-35fc-b3cf-73f4bd3fe32a") @pos(-640, 0) @with(name: "guichet") {
    blueprint:gui/open(player: $player, screen: "guichet") @id("5b947b5a-ea93-3738-86de-b6f055377cb2") @pos(-400, 0)
    blueprint:gui/refresh(player: $player, screen: "guichet") @id("931c51af-f2ed-36cb-a30a-283a591084e1") @pos(-160, 0)
  }
}
