blueprint blueprint:example/compteur_de_blocs {
  meta {
    author "Blueprint"
    description "Compter les blocs cassés, dans le scoreboard"
    version "1.0.0"
    permission GAMEPLAY
  }
  var double dernier_total = 0.0 @graph
  on blueprint:event/player_break_block(player, pos) @id("df9395bb-7760-3ad2-9209-cb7b71736223") @pos(-520, 0) {
    blueprint:score/add(entity: $player, objective: "blocs", amount: 1) @id("0c892ad9-74ca-3739-bb52-ea5074be0ddf") @pos(-240, 0)
    blueprint:player/action_bar(player: $player, text: blueprint:string/concat(a: "Blocs cassés : ", b: blueprint:convert/to_string(value: $node("0c892ad9-74ca-3739-bb52-ea5074be0ddf").score) @id("24be903a-4ec6-30ff-a696-919f5313f703") @pos(0, 160)) @id("4005c5eb-7612-36f6-a1da-adabc44359b6") @pos(240, 160)) @id("1cda1e0f-ab22-32d4-ba9e-62dcf063c136") @pos(480, 0)
  }
}
