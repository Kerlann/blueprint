blueprint blueprint:example/banque {
  meta {
    author "Blueprint"
    description "Une banque : un distributeur qu'on clique, un compte, des pièces et des lingots"
    version "1.0.0"
    permission GAMEPLAY
  }
  var int compte = 0 @player
  var int montant = 0 @graph
  screen "banque" {
    styles {
      "bouton" = "#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center
    }
    panel "cadre" @at(center, 0, 0) @size(176, 124) @layout(column, gap: 4, cross: stretch) @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "titre" @in("cadre") @at(top_left, 0, 0) @size(fill, 12) @text("Distributeur") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "solde" @in("cadre") @at(top_left, 0, 0) @size(fill, 12) @bind("compte", text, format: "Compte : %s pièces") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    input "montant" @in("cadre") @at(top_left, 0, 0) @size(fill, 16) @tip("La somme à déposer ou à retirer") @opts(placeholder: "Montant", maxLength: 6, filter: integer) @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    button "deposer" @in("cadre") @at(top_left, 0, 0) @size(fill, 20) @text("Déposer des pièces") @tip("Prend les pièces de votre inventaire") @uses("bouton") @style("#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center)
    button "retirer" @in("cadre") @at(top_left, 0, 0) @size(fill, 20) @text("Retirer") @tip("Rend des lingots de 100 et l'appoint en pièces") @uses("bouton") @style("#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center)
    button "fermer" @in("cadre") @at(top_left, 0, 0) @size(fill, 20) @text("Fermer") @uses("bouton") @style("#C01F2735", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C0141519", "#60141519", 3, center)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("9d888a2f-9622-38c3-a4f4-85cb295fdfdd") @pos(-700, 1500) @with(element: "fermer") {
    blueprint:gui/close(player: $player) @id("81a8c203-eff8-3d7a-91da-15d4523fb3a2") @pos(-420, 1500)
  }
  on blueprint:event/gui_input_changed(player, screen, element, text, submitted) @id("a3a174a3-3e11-3839-958f-6189cbeb9488") @pos(-700, 400) @with(element: "montant") {
    blueprint:var/set(var: "montant", value: blueprint:convert/to_int(value: blueprint:convert/to_number(text: $text) @id("811a0f74-1b45-3f65-ae27-1f0211562196") @pos(-420, 600)) @id("2dbdeec1-0dd7-3b0c-b607-024a0ee96d68") @pos(-140, 600)) @id("e290093b-6d73-3c1d-bb38-2bdbc5a8103f") @pos(-420, 400)
  }
  on blueprint:event/player_use_block(player, pos, face) @id("e03a98d8-9576-341e-8df2-64960679ab7f") @pos(-700, 0) {
    blueprint:world/is_block(pos: $pos, block: "blueprint:distributeur") @id("05a24ab7-6ba9-3464-a3a3-7a5600c3a9b7") @pos(-420, 200)
    blueprint:flow/branch(condition: $node("05a24ab7-6ba9-3464-a3a3-7a5600c3a9b7").matches) @id("f08cdee6-4a8a-3749-8870-1b9a81b13901") @pos(-420, 0) {
      true: {
        blueprint:gui/open(player: $player, screen: "banque") @id("d63bf9f8-ac6f-3b68-aef7-252ada199b22") @pos(-140, 0)
        blueprint:gui/refresh(player: $player, screen: "banque") @id("7226ac0f-c155-3183-89f8-09f9f32906ba") @pos(140, 0)
      }
    }
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("efa0ac87-6667-3309-b99b-819f17385f31") @pos(-700, 800) @with(element: "deposer") {
    blueprint:player/remove_item(player: $player, item: "blueprint:piece", count: blueprint:var/get(var: "montant") @id("038a189c-cb67-33bf-8288-01bc7e2bd3a6") @pos(-700, 1000)) @id("695eb508-730b-3778-bab3-826b8547067a") @pos(-420, 800)
    blueprint:var/set(var: "compte", value: blueprint:math/add(a: blueprint:var/get(var: "compte") @id("ccb647d4-6020-3fa9-b9a9-7688f02a67a6") @pos(-140, 1000), b: $node("695eb508-730b-3778-bab3-826b8547067a").removed) @id("20f79600-aac2-3fda-be7e-8cf41370fab8") @pos(140, 1000)) @id("98506eb0-d3b8-3d94-91da-cddd08ff4ed6") @pos(-140, 800)
    blueprint:gui/refresh(player: $player, screen: "banque") @id("2d79ed65-d45f-30f7-a026-1b1f18086017") @pos(140, 800)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("03b23e78-301f-31d4-936d-3df5bf25482a") @pos(-700, 1200) @with(element: "retirer") {
    blueprint:flow/branch(condition: blueprint:logic/greater_eq(a: blueprint:var/get(var: "compte") @id("19d7f46c-868e-3ed5-815b-eb21b79c1b0b") @pos(-700, 1340), b: blueprint:var/get(var: "montant") @id("b6b5e45b-e6c2-3da0-8bbc-db1b0d897a4a") @pos(-700, 1400)) @id("bf2eafa4-76bf-3e83-9b16-c0c77da94abb") @pos(-560, 1340)) @id("d032757b-3c98-3bab-b947-2c27826dfea6") @pos(-420, 1200) {
      true: {
        blueprint:var/set(var: "compte", value: blueprint:math/sub(a: blueprint:var/get(var: "compte") @id("19d7f46c-868e-3ed5-815b-eb21b79c1b0b") @pos(-700, 1340), b: blueprint:var/get(var: "montant") @id("b6b5e45b-e6c2-3da0-8bbc-db1b0d897a4a") @pos(-700, 1400)) @id("eee000ec-d86c-3343-9e16-7acfb1b7378e") @pos(-280, 1400)) @id("57df9c8e-d241-3cf8-87eb-4f5bcdf31c3b") @pos(-280, 1200)
        blueprint:player/give_item(player: $player, item: blueprint:item/create(item: "blueprint:lingot", count: blueprint:convert/to_int(value: blueprint:math/div(a: blueprint:var/get(var: "montant") @id("b6b5e45b-e6c2-3da0-8bbc-db1b0d897a4a") @pos(-700, 1400), b: 100.0) @id("d6eb2f38-575f-384f-81ed-14e3ce865d34") @pos(-140, 1400)) @id("62b73ca0-cb3d-3375-9e02-155826b52d40") @pos(0, 1400)) @id("be113c89-66a3-3da3-be2c-3e8c0dd9b7c1") @pos(140, 1400)) @id("1c7fb7eb-2fb7-3dcd-b4fe-05496100435c") @pos(-140, 1200)
        blueprint:player/give_item(player: $player, item: blueprint:item/create(item: "blueprint:piece", count: blueprint:convert/to_int(value: blueprint:math/mod(a: blueprint:var/get(var: "montant") @id("b6b5e45b-e6c2-3da0-8bbc-db1b0d897a4a") @pos(-700, 1400), b: 100.0) @id("7656b458-9688-3d31-93c4-e58f8778193f") @pos(-140, 1460)) @id("3d3df7d5-a9c7-3891-9aa8-b5df52184255") @pos(0, 1460)) @id("f4185440-a7e9-3353-8893-238956a0e98c") @pos(140, 1460)) @id("a3cc18bf-8e17-31fb-a001-834a0c5d6bcb") @pos(0, 1200)
        blueprint:gui/refresh(player: $player, screen: "banque") @id("86e1976b-c54e-32b4-bd98-766adf663c78") @pos(140, 1200)
      }
      false: {
        blueprint:player/send_message(player: $player, text: "Solde insuffisant pour ce retrait.") @id("e5fa27f5-b7e9-306c-b40f-46a061189ee1") @pos(-280, 1100)
      }
    }
  }
}
