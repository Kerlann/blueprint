blueprint blueprint:example/relais_de_signal {
  meta {
    author "Blueprint"
    description "Émettre un signal ici, l'écouter là"
    version "1.0.0"
    permission GAMEPLAY
  }
  on blueprint:event/player_chat(player, message) @id("13f1f406-c48e-3b25-9e8e-fe7913637bac") @pos(-520, -160) {
    blueprint:flow/branch(condition: blueprint:string/contains(value: $message, search: "alerte") @id("842c4e2b-0ef4-3bc4-8925-4ce24cfc3281") @pos(-280, -60)) @id("7d977102-8ef5-328a-a602-d27d3156c7c9") @pos(-40, -160) {
      true: {
        blueprint:signal/emit(name: "alarme", payload: $message) @id("9c179b66-9579-3321-9393-6b214064b942") @pos(200, -160)
      }
    }
  }
  on blueprint:event/signal(payload) @id("777ef048-9b41-3486-a229-71c9f9572dbf") @pos(-520, 200) @with(name: "alarme") {
    blueprint:query/players() @id("e72b9627-6e6e-33f7-9404-cc6c766af235") @pos(-280, 200)
    blueprint:flow/for_each(list: $node("e72b9627-6e6e-33f7-9404-cc6c766af235").players) @id("873f7459-9889-3533-8ae9-f523f2dad785") @pos(-40, 200) {
      body: {
        blueprint:player/title(player: $node("873f7459-9889-3533-8ae9-f523f2dad785").element, text: "ALERTE") @id("98eacf96-c849-3b57-988b-a2ca94010607") @pos(200, 200)
      }
    }
  }
}
