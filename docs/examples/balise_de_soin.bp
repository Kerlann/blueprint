blueprint blueprint:example/balise_de_soin {
  meta {
    author "Blueprint"
    description "Soigner les joueurs proches, toutes les 5 s"
    version "1.0.0"
    permission GAMEPLAY
  }
  on blueprint:event/server_tick() @id("0e0729f2-9cf9-33f3-89c2-df2a34b46954") @pos(-640, 0) {
    blueprint:flow/wait(ticks: 100) @id("81d69f17-c6f2-3f79-bcca-297d283c0751") @pos(-400, 0)
    blueprint:query/nearest_player(pos: blueprint:vec/make(x: 0.0, y: 64.0, z: 0.0) @id("94645fac-f25e-3080-9524-8299e5d5429e") @pos(-400, 200), radius: 8.0) @id("24dd1105-8f35-3ee7-a01e-d9efc954f3df") @pos(-160, 0)
    blueprint:flow/branch(condition: $node("24dd1105-8f35-3ee7-a01e-d9efc954f3df").found) @id("966102b6-2bcb-3282-8c44-6ff6a14a2f56") @pos(80, 0) {
      true: {
        blueprint:entity/heal(entity: $node("24dd1105-8f35-3ee7-a01e-d9efc954f3df").player, amount: 2.0) @id("1e4e027f-b553-37a9-afef-4b29ff878ee9") @pos(320, -60)
        blueprint:player/play_sound(player: $node("24dd1105-8f35-3ee7-a01e-d9efc954f3df").player, sound: "minecraft:block.beacon.activate") @id("45fed2da-3e1c-333c-8cb0-1ad05fb257ad") @pos(560, -60)
      }
    }
  }
}
