blueprint blueprint:example/porte_secrete {
  meta {
    author "Blueprint"
    description "Clic droit sur un bloc → poser un bloc sur la face touchée"
    version "1.0.0"
    permission WORLD
  }
  on blueprint:event/player_use_block(player, pos, face) @id("ad7e6186-a4e2-3dbb-8292-3345c4eaef9d") @pos(-520, 0) {
    blueprint:world/block_state(block: "minecraft:stone") @id("7f8f76b8-a1dc-3c4e-8539-2e3407098175") @pos(-260, 0)
    blueprint:world/set_block(pos: blueprint:pos/relative(pos: $pos, direction: $face, distance: 1) @id("657d3b48-6daf-3862-982f-40f1d78141c1") @pos(-260, 200), state: $node("7f8f76b8-a1dc-3c4e-8539-2e3407098175").state) @id("8ef5dae8-0970-3dc1-b106-b3f00b90195d") @pos(40, 0)
  }
}
