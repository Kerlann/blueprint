blueprint blueprint:example/reglement {
  meta {
    author "Blueprint"
    description "Une page de règles qui défile et se lit"
    version "1.0.0"
    permission GAMEPLAY
  }
  screen "reglement" {
    styles {
      "paragraphe" = "#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap
    }
    panel "page" @at(center, 0, -12) @size(70%[160, 400], 60%[90, 260]) @layout(column, gap: 4, cross: stretch, scroll: vertical) @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "titre" @in("page") @at(top_left, 0, 0) @size(fill, 12) @text("Règlement du serveur") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    label "regle1" @in("page") @at(top_left, 0, 0) @size(fill, 30) @text("1. Restez courtois. Un désaccord se règle par la parole, pas par la pioche.") @uses("paragraphe") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap)
    label "regle2" @in("page") @at(top_left, 0, 0) @size(fill, 30) @text("2. Ne construisez pas à moins de cinquante blocs d'une base habitée sans l'accord de ses occupants.") @uses("paragraphe") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap)
    label "regle3" @in("page") @at(top_left, 0, 0) @size(fill, 30) @text("3. Les fermes automatiques sont autorisées tant qu'elles ne font pas chuter le nombre d'images par seconde des autres joueurs.") @uses("paragraphe") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap)
    label "regle4" @in("page") @at(top_left, 0, 0) @size(fill, 30) @text("4. Le contenu d'un coffre appartient à qui l'a posé, même sans cadenas.") @uses("paragraphe") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap)
    label "regle5" @in("page") @at(top_left, 0, 0) @size(fill, 30) @text("5. Signalez les défauts plutôt que de les exploiter : ils seront corrigés, et vous serez remercié.") @uses("paragraphe") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left, wrap)
    button "haut" @at(bottom_center, -34, -8) @size(60, 16) @text("Haut de page") @tip("Revenir au début du règlement") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
    button "fermer" @at(bottom_center, 34, -8) @size(60, 16) @text("Fermer") @tip("Ferme la page. Échap fait la même chose.") @style("#C0141519", "#FF6B7280", 1, "#FFE6E6E6", "#C02F3A55", "#C01F2735", "#60141519", 2, left)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("9c872d0b-382c-3dd1-bd52-31e0e135c5db") @pos(-640, 520) @with(element: "fermer") {
    blueprint:gui/close(player: $player) @id("ed1fef49-885b-3b01-bdcc-779a86c7646f") @pos(-400, 520)
  }
  on blueprint:event/gui_clicked(player, screen, element) @id("d149d650-03a8-3995-84a1-1be05f22d6a2") @pos(-640, 260) @with(element: "haut") {
    blueprint:gui/set_scroll(player: $player, screen: "reglement", element: "page", offset: 0.0) @id("3bd1d77e-09f8-344a-b74f-5a51089c0010") @pos(-400, 260)
  }
  on blueprint:event/command(player, name, arg) @id("f30d0015-d1d9-3947-8b44-2bed13208c83") @pos(-640, 0) @with(name: "reglement") {
    blueprint:gui/open(player: $player, screen: "reglement") @id("2427bb21-241d-30fe-a556-21796637324a") @pos(-400, 0)
  }
}
