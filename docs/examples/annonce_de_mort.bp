blueprint blueprint:example/annonce_de_mort {
  meta {
    author "Blueprint"
    description "Annoncer la mort d'un joueur, avec infobulle"
    version "1.0.0"
    permission GAMEPLAY
  }
  on blueprint:event/entity_death(entity) @id("4c69203f-09e2-3ab6-a6a1-a02ab0f86691") @pos(-640, 0) {
    blueprint:entity/as_player(entity: $entity) @id("86a7aec6-333a-3fd5-80cc-07d5c09806dc") @pos(-400, 0)
    blueprint:flow/branch(condition: $node("86a7aec6-333a-3fd5-80cc-07d5c09806dc").is_player) @id("78ecabb2-94d2-39ae-b122-0e86ba9c9211") @pos(-160, 0) {
      true: {
        blueprint:entity/name(entity: $entity) @id("2225e298-5c5a-3e32-8bf1-719fc158361a") @pos(-160, 200)
        blueprint:player/send_text(player: $node("86a7aec6-333a-3fd5-80cc-07d5c09806dc").player, text: blueprint:text/hover(text: blueprint:text/literal(value: $node("2225e298-5c5a-3e32-8bf1-719fc158361a").name) @id("8e12881a-cd96-3f16-8d7d-2694af92468f") @pos(80, 200), tooltip: blueprint:text/literal(value: "Repose en paix") @id("b2ca67a3-c68e-3514-b89f-8e38d8f72632") @pos(80, 340)) @id("359e65f5-de33-3068-b043-39957077865b") @pos(320, 200)) @id("45901607-fdd1-3365-bf37-443757c83554") @pos(560, 0)
      }
    }
  }
}
